{
  "name": "block-spire",
  "private": true,
  "version": "1.0.0",
  "description": "方块尖塔 · Block Spire：开箱组军，以怪斗怪，登塔屠龙的网页游戏",
  "license": "CC-BY-NC-SA-4.0",
  "homepage": "https://blockspire.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrimsonAishia/BlockSpire.git"
  },
  "bugs": {
    "url": "https://github.com/CrimsonAishia/BlockSpire/issues"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "server": "python server/api.py",
    "deploy": "python deploy.py",
    "dev": "vite",
    "build": "node scripts/subset-font.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --experimental-strip-types --no-warnings scripts/test-commander-tactics.ts && node --experimental-strip-types --no-warnings scripts/test-battle-ai.ts && node --experimental-strip-types --no-warnings scripts/test-ai-safety.ts",
    "test:ai": "node --experimental-strip-types --no-warnings scripts/test-battle-ai.ts && node --experimental-strip-types --no-warnings scripts/test-ai-safety.ts",
    "font": "node scripts/subset-font.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "mistreevous": "^4.3.1",
    "preact": "^10.29.8",
    "three": "^0.186.1",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@plugin-web-update-notification/vite": "^2.1.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/yuka": "^0.7.4",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}

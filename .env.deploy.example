# deploy.py 远程服务器发布配置（重命名为 .env.deploy 即可生效）
DEPLOY_HOST=YOUR_SERVER_IP
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_PASSWORD=
# 如使用私钥登录，可填私钥绝对路径，例如：
# DEPLOY_KEY=C:/Users/Aishia-VM/.ssh/id_rsa

# 提权配置（默认为 true）
DEPLOY_USE_SUDO=true
# sudo 提权密码（留空则默认复用 DEPLOY_PASSWORD 或在终端提示输入）
DEPLOY_SUDO_PASSWORD=

# 远程部署目标目录（留空则默认使用 1Panel/OpenResty 站点目录）
DEPLOY_REMOTE_DIR=/home/aishia/Develop/1panel/apps/openresty/openresty/www/sites/gBlockSpire.aishia.cc/index
# 解压时是否包含 dist 子目录（true: 解压至 $DEPLOY_REMOTE_DIR/dist; false: 直接解压至 $DEPLOY_REMOTE_DIR）
# 默认为 false（推荐直接解压到站点根目录）
DEPLOY_WITH_DIST=false

# ───────── 排行榜后端与 Redis 服务配置 ─────────
# 后端 HTTP 监听端口（供 OpenResty / Nginx 反代）
PORT=3000
# 本地 Redis 连接配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
